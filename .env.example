# Everything prefixed EXPO_PUBLIC_ is inlined into the JS bundle at build time
# and is readable by anyone with the APK. URLs and public identifiers only —
# a secret placed here is a published secret.

# The API. Defaults to production when unset, because `localhost` on a phone is
# the phone: pointing at a dev machine needs its LAN address, or an
# `adb reverse tcp:8080 tcp:8080` so that localhost really is the laptop.
#
# EXPO_PUBLIC_API_URL=http://192.168.1.10:8080/api/v1
# EXPO_PUBLIC_WS_URL=ws://192.168.1.10:8080/api/v1/realtime/ws
